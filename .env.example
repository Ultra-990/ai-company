APP_NAME=AI Company
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/ai_company.db

# Nie wpisuj tutaj prawdziwych kluczy.
LLM_PROVIDER=disabled
LLM_API_KEY=

# RBAC — ustaw różne, silne wartości w lokalnym .env lub w sekretach CI/CD.
OWNER_API_TOKEN=change-me-owner-token
WORKER_API_TOKEN=change-me-worker-token

# Ustaw 1 dla panelu uruchamianego bezpośrednio na tym komputerze (loopback).
# Wtedy przeglądarka otwiera sesję właściciela bez wpisywania tokena.
LOCAL_OWNER_ACCESS=0
